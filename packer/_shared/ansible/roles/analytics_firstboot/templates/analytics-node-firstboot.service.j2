[Unit]
Description=analytics-node firstboot (NIC discovery, hostname mapping, VMnet10 backplane, node-identity env)
After=systemd-networkd.service network-online.target
Wants=network-online.target
# No Before= for the role services -- firstboot does NOT enable any ClickHouse /
# StarRocks service (their config needs per-host data rendered by the Terraform
# role-overlays: Keeper raft id, ClickHouse macros {shard}/{replica}, StarRocks
# FE/BE join). The role-overlays enable exactly one role service per node
# post-apply.
ConditionPathExists=!/var/lib/analytics-node-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/analytics-node-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
